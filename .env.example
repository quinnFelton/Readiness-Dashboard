# Copy to .env (never commit .env). Agents can read this file, not .env.
NODE_ENV=development
DATABASE_URL=postgres://rd:rd@localhost:5432/readiness
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# App auth (NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Local token encryption (32-byte base64). Prod uses KMS via the same TokenCipher interface.
TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Oura (cloud.ouraring.com developer portal)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:4000/api/v1/connections/oura/callback
OURA_USE_SANDBOX=true
# Oura webhooks (phase 3a). The client secret above also signs deliveries (x-oura-signature).
OURA_WEBHOOK_VERIFICATION_TOKEN=replace-with-random-string
OURA_WEBHOOK_CALLBACK_URL=http://localhost:4000/api/v1/webhooks/oura
# Optional Oura tuning (defaults per packages/provider-adapters/src/oura/config.ts; leave unset):
# OURA_SCOPES=daily personal
# OURA_LOOKBACK_DAYS=30
# OURA_OVERLAP_DAYS=2
# OURA_REFRESH_SKEW_SEC=300
# OURA_MAX_RETRY_AFTER_SEC=30
# OURA_MAX_RATE_LIMIT_RETRIES=3
# OURA_WEBHOOK_TOLERANCE_SEC=300
# OURA_WEBHOOK_LOOKBACK_DAYS=3
# OURA_WEBHOOK_DATA_TYPES=daily_readiness,daily_sleep,sleep
# OURA_WEBHOOK_EVENT_TYPES=create,update,delete
# OURA_SUBSCRIPTION_RENEW_WITHIN_SEC=604800
# OURA_API_BASE_URL=https://api.ouraring.com
# OURA_AUTHORIZE_URL=https://cloud.ouraring.com/oauth/authorize
# OURA_TOKEN_URL=https://api.ouraring.com/oauth/token

# Strava (strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:4000/api/v1/connections/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=replace-with-random-string
# Pin webhook POSTs to our push subscription id (empty = not pinned).
STRAVA_SUBSCRIPTION_ID=
# Training-load heuristic inputs (phase 4, PLAN §5.2); unset = scoring-engine defaults.
STRAVA_FTP=
HR_MAX=
HR_REST=

# Terra (Zepp / Amazfit)
TERRA_DEV_ID=
TERRA_API_KEY=
TERRA_SIGNING_SECRET=
# The adapter is only registered when TERRA_DEV_ID, TERRA_API_KEY and this are all set.
TERRA_SUCCESS_REDIRECT_URL=http://localhost:3000/settings
TERRA_FAILURE_REDIRECT_URL=http://localhost:3000/settings
# Comma-separated Terra provider codes for the widget (empty = all), e.g. ZEPP
TERRA_PROVIDERS=
TERRA_WEBHOOK_TOLERANCE_SEC=300
TERRA_BACKFILL_DAYS=90

# Classifier / ingest config (PLAN §17 — calibrate with real data)
CLASSIFIER_Z_DEADZONE=0.5
MIN_ACTIVITY_DURATION_SEC=1200
# Daily-metrics source precedence default (phase 2, PLAN §4); per-user config overrides it.
DAILY_METRICS_DEFAULT_SOURCE_ORDER=oura,terra

# AWS (deploy only; CI uses GitHub OIDC)
AWS_REGION=us-west-2
KMS_KEY_ID=
